# ==============================================================================
# Distributed Job Scheduler (DJS) - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Server & Network Configuration
PORT=4000
WS_PORT=4001
NODE_ENV=development

# Authentication & Security
JWT_SECRET=djs-super-secret-jwt-key-change-this-in-production-32chars
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
# In standalone/local mode, defaults to ./backend/djs_database.sqlite
DB_PATH=./backend/djs_database.sqlite

# Redis & Message Broker Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
USE_EMBEDDED_BROKER=true

# Worker Engine & Fleet API Configuration
WORKER_API_PORT=5001
WORKER_API_URL=http://127.0.0.1:5001

# Distributed Scheduler Engine Configuration
SCHEDULER_POLL_INTERVAL_MS=2000
STALE_WORKER_THRESHOLD_SEC=30
SCHEDULER_LEADER_LOCK_TTL_MS=10000

# AI-Powered Failure Analysis (Gemini)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
